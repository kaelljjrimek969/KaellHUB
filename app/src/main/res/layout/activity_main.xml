<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">
    <TextView android:id="@+id/tvAppName" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="KaellHUB" android:textColor="@color/accent_purple" android:textSize="24sp"
        android:textStyle="bold" android:paddingHorizontal="16dp" android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/tvRamInfo" android:layout_width="0dp" android:layout_height="wrap_content"
        android:text="RAM bebas: —" android:textColor="@color/text_secondary" android:textSize="12sp"
        android:paddingHorizontal="16dp" android:paddingTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppName"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <Button android:id="@+id/btnBoost" android:layout_width="wrap_content" android:layout_height="36dp"
        android:text="BOOST" android:textSize="12sp" android:backgroundTint="@color/accent_purple"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="@id/tvRamInfo" app:layout_constraintBottom_toBottomOf="@id/tvRamInfo"
        app:layout_constraintEnd_toEndOf="parent" android:layout_marginEnd="16dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvGames"
        android:layout_width="0dp" android:layout_height="0dp"
        android:clipToPadding="false" android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvRamInfo" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
